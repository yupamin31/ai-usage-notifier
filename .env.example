# Discord Bot credentials. Never commit the real token.
DISCORD_BOT_TOKEN=replace-me
DISCORD_CHANNEL_ID=your-channel-id

# Optional overrides. Paths support a leading ~ in config.json too.
# CODEX_HOME=~/.codex
# CODEX_NOTIFIER_CONFIG=./config/config.json
# CODEX_NOTIFIER_LOG_DIR=~/Library/Logs/CodexNotifier
# CODEX_NOTIFIER_STATE_DIR=~/Library/Application Support/CodexNotifier
